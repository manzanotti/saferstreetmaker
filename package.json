{
    "scripts": {
        "start": "vite",
        "build": "prettier --check . --ignore-path .gitignore && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "test": "playwright test --config=tests/playwright.config.ts",
        "test:unit": "vitest run --config=tests/vitest.config.ts",
        "test:unit:watch": "vitest --config=tests/vitest.config.ts",
        "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/leaflet": "^1.9.21",
        "@types/lz-string": "^1.5.0",
        "@types/node": "^25.9.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/tsconfig": "^0.9.1",
        "fake-indexeddb": "^6.2.4",
        "jsdom": "^29.1.1",
        "leaflet-arrowheads": "^1.4.0",
        "leaflet-geometryutil": "^0.10.3",
        "lz-string": "^1.5.0",
        "prettier": "^3.8.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-externals": "^0.6.2",
        "vitest": "^4.1.8",
        "vue-tsc": "^3.3.5"
    },
    "dependencies": {
        "dexie": "^4.2.0",
        "pinia": "^3.0.4",
        "tailwindcss": "^4.3.0",
        "vue": "^3.5.38"
    },
    "packageManager": "yarn@3.6.1",
    "version": "0.0.0"
}
