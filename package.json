{
    "scripts": {
        "start": "vite",
        "build": "prettier --check . --ignore-path .gitignore && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check . --ignore-path .gitignore",
        "test": "playwright test --config=tests/playwright.config.ts",
        "test:unit": "vitest run --config=tests/vitest.config.ts",
        "test:unit:watch": "vitest --config=tests/vitest.config.ts",
        "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/leaflet": "^1.9.22",
        "@types/lz-string": "^1.5.0",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "fake-indexeddb": "^6.2.6",
        "jsdom": "^30.1.3",
        "leaflet-arrowheads": "^1.4.0",
        "leaflet-geometryutil": "^0.10.3",
        "lz-string": "^1.5.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vite-plugin-externals": "^0.6.2",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "dependencies": {
        "@vue/devtools-api": "^8.2.1",
        "dexie": "^4.4.6",
        "dompurify": "^3.4.17",
        "html2canvas-pro": "^2.5.2",
        "pinia": "^4.1.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44"
    },
    "engines": {
        "node": ">=24.15.0 <25"
    },
    "packageManager": "yarn@3.6.1",
    "version": "0.0.0"
}
